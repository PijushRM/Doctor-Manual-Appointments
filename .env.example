# Copy to .env and fill in. Optional overrides: .env.development (debug builds)
# and .env.production (release builds), which win over .env.
#
# Backend base URL, no trailing slash. Release builds need https.
# Examples:
#   https://<tunnel-id>-3000.inc1.devtunnels.ms
#   http://localhost:3000        (debug only, with: adb reverse tcp:3000 tcp:3000)
#   http://192.168.1.20:3000     (debug only, this computer's Wi-Fi IP)
API_URL=
